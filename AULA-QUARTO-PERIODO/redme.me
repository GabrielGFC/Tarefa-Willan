### exercicios/bidimensional/exercicio11.c

*Multiplicação de Matrizes*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int m, n, p, i, j, k;
    int **A, **B, **C;

    printf("Digite o numero de linhas de A (m): ");
    scanf("%d", &m);
    printf("Digite o numero de colunas de A e linhas de B (n): ");
    scanf("%d", &n);
    printf("Digite o numero de colunas de B (p): ");
    scanf("%d", &p);

    A = (int **)malloc(m * sizeof(int *));
    B = (int **)malloc(n * sizeof(int *));
    C = (int **)malloc(m * sizeof(int *));
    if(A == NULL || B == NULL || C == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < m; i++) {
        A[i] = (int *)malloc(n * sizeof(int));
        C[i] = (int *)malloc(p * sizeof(int));
        if(A[i] == NULL || C[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }
    for(i = 0; i < n; i++) {
        B[i] = (int *)malloc(p * sizeof(int));
        if(B[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    printf("Digite os elementos da matriz A (%dx%d):\n", m, n);
    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++){
            printf("A[%d][%d]: ", i, j);
            scanf("%d", &A[i][j]);
        }

    printf("Digite os elementos da matriz B (%dx%d):\n", n, p);
    for(i = 0; i < n; i++)
        for(j = 0; j < p; j++){
            printf("B[%d][%d]: ", i, j);
            scanf("%d", &B[i][j]);
        }

    for(i = 0; i < m; i++){
        for(j = 0; j < p; j++){
            C[i][j] = 0;
            for(k = 0; k < n; k++){
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    printf("Matriz produto (A x B):\n");
    for(i = 0; i < m; i++){
        for(j = 0; j < p; j++){
            printf("%d ", C[i][j]);
        }
        printf("\n");
    }

    for(i = 0; i < m; i++){
        free(A[i]);
        free(C[i]);
    }
    free(A);
    free(C);
    for(i = 0; i < n; i++)
        free(B[i]);
    free(B);

    return 0;
}

```

