#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int linha;
    int coluna;
    int valor;
} Elemento;

int main(void) {
    int m, n, i, j, count = 0;
    int **mat;
    Elemento *vetEsparso;

    printf("Digite o numero de linhas da matriz: ");
    scanf("%d", &m);
    printf("Digite o numero de colunas da matriz: ");
    scanf("%d", &n);

    mat = (int **)malloc(m * sizeof(int *));
    if(mat == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < m; i++) {
        mat[i] = (int *)malloc(n * sizeof(int));
        if(mat[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    printf("Digite os elementos da matriz:\n");
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++){
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
            if(mat[i][j] != 0)
                count++;
        }
    }

    vetEsparso = (Elemento *)malloc(count * sizeof(Elemento));
    if(vetEsparso == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    int index = 0;
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++) {
            if(mat[i][j] != 0) {
                vetEsparso[index].linha = i;
                vetEsparso[index].coluna = j;
                vetEsparso[index].valor = mat[i][j];
                index++;
            }
        }
    }

    printf("Elementos nao-zero da matriz:\n");
    for(i = 0; i < count; i++) {
        printf("Linha: %d, Coluna: %d, Valor: %d\n",
               vetEsparso[i].linha, vetEsparso[i].coluna, vetEsparso[i].valor);
    }

    for(i = 0; i < m; i++)
        free(mat[i]);
    free(mat);
    free(vetEsparso);

    return 0;
}

```

