### exercicios/unidimensional/exercicio7.c

*Concatenação de Dois Vetores*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, m, i;
    int *vet1, *vet2, *vet3;

    printf("Digite o tamanho do primeiro vetor: ");
    scanf("%d", &n);
    vet1 = (int *)malloc(n * sizeof(int));
    if(vet1 == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    printf("Digite os %d elementos do primeiro vetor:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet1[i]);
    }

    printf("Digite o tamanho do segundo vetor: ");
    scanf("%d", &m);
    vet2 = (int *)malloc(m * sizeof(int));
    if(vet2 == NULL) {
        printf("Erro na alocacao.\n");
        free(vet1);
        return 1;
    }
    printf("Digite os %d elementos do segundo vetor:\n", m);
    for(i = 0; i < m; i++) {
        scanf("%d", &vet2[i]);
    }

    vet3 = (int *)malloc((n + m) * sizeof(int));
    if(vet3 == NULL) {
        printf("Erro na alocacao.\n");
        free(vet1);
        free(vet2);
        return 1;
    }

    for(i = 0; i < n; i++)
        vet3[i] = vet1[i];
    for(i = 0; i < m; i++)
        vet3[n + i] = vet2[i];

    printf("Vetor concatenado:\n");
    for(i = 0; i < n + m; i++) {
        printf("%d ", vet3[i]);
    }
    printf("\n");

    free(vet1);
    free(vet2);
    free(vet3);
