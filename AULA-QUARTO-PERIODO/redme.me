### exercicios/bidimensional/exercicio14.c

*Soma das Linhas e Colunas*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int m, n, i, j;
    int **mat, *somaLinhas, *somaColunas;

    printf("Digite o numero de linhas (m): ");
    scanf("%d", &m);
    printf("Digite o numero de colunas (n): ");
    scanf("%d", &n);

    mat = (int **)malloc(m * sizeof(int *));
    if(mat == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < m; i++) {
        mat[i] = (int *)malloc(n * sizeof(int));
        if(mat[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    somaLinhas = (int *)malloc(m * sizeof(int));
    somaColunas = (int *)malloc(n * sizeof(int));
    if(somaLinhas == NULL || somaColunas == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    for(i = 0; i < m; i++) somaLinhas[i] = 0;
    for(j = 0; j < n; j++) somaColunas[j] = 0;

    printf("Digite os elementos da matriz:\n");
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++){
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
            somaLinhas[i] += mat[i][j];
            somaColunas[j] += mat[i][j];
        }
    }

    printf("Soma das linhas:\n");
    for(i = 0; i < m; i++)
        printf("Linha %d: %d\n", i, somaLinhas[i]);

    printf("Soma das colunas:\n");
    for(j = 0; j < n; j++)
        printf("Coluna %d: %d\n", j, somaColunas[j]);

    for(i = 0; i < m; i++)
        free(mat[i]);
    free(mat);
    free(somaLinhas);
    free(somaColunas);

    return 0;
}

