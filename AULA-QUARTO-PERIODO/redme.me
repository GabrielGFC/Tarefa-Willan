### exercicios/unidimensional/exercicio5.c

*Remover Elementos Duplicados*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, i, j, uniqueCount = 0;
    int *vet, *vetUnico;

    printf("Digite a quantidade de numeros: ");
    scanf("%d", &n);

    vet = (int *)malloc(n * sizeof(int));
    if(vet == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    printf("Digite os %d numeros:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet[i]);
    }

    // Aloca vetor para armazenar os valores únicos (no máximo n elementos)
    vetUnico = (int *)malloc(n * sizeof(int));
    if(vetUnico == NULL) {
        printf("Erro na alocacao.\n");
        free(vet);
        return 1;
    }

    for(i = 0; i < n; i++) {
        int duplicado = 0;
        for(j = 0; j < uniqueCount; j++) {
            if(vet[i] == vetUnico[j]) {
                duplicado = 1;
                break;
            }
        }
        if(!duplicado) {
            vetUnico[uniqueCount++] = vet[i];
        }
    }

    printf("Valores unicos:\n");
    for(i = 0; i < uniqueCount; i++) {
        printf("%d ", vetUnico[i]);
    }
    printf("\n");

    free(vet);
    free(vetUnico);
    return 0;
}

