### exercicios/unidimensional/exercicio4.c

*Redimensionamento de Vetor (realloc)*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, m, i;
    int *vet;

    printf("Digite o tamanho inicial do vetor: ");
    scanf("%d", &n);

    vet = (int *)malloc(n * sizeof(int));
    if(vet == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    printf("Digite os %d valores:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet[i]);
    }

    printf("Digite o novo tamanho do vetor: ");
    scanf("%d", &m);

    int *temp = (int *)realloc(vet, m * sizeof(int));
    if(temp == NULL) {
        printf("Erro no redimensionamento.\n");
        free(vet);
        return 1;
    }
    vet = temp;

    if(m > n) {
        printf("Digite os %d novos valores:\n", m - n);
        for(i = n; i < m; i++) {
            scanf("%d", &vet[i]);
        }
    }

    printf("Vetor redimensionado:\n");
    for(i = 0; i < m; i++) {
        printf("%d ", vet[i]);
    }
    printf("\n");

    free(vet);
    return 0;
}

