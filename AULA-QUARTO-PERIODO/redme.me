### exercicios/unidimensional/exercicio3.c

*Maior e Menor Valor*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, i, maior, menor;
    int *vet;

    printf("Digite o tamanho do vetor: ");
    scanf("%d", &n);

    vet = (int *)malloc(n * sizeof(int));
    if(vet == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    printf("Digite os %d valores:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet[i]);
    }

    maior = menor = vet[0];
    for(i = 1; i < n; i++) {
        if(vet[i] > maior)
            maior = vet[i];
        if(vet[i] < menor)
            menor = vet[i];
    }

    printf("Maior valor: %d\n", maior);
    printf("Menor valor: %d\n", menor);

    free(vet);
    return 0;
}

