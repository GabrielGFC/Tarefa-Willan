### exercicios/unidimensional/exercicio8.c

*Ordenação (Bubble Sort)*

```c
#include <stdio.h>
#include <stdlib.h>

void bubbleSort(int *vet, int n) {
    int i, j, temp;
    for(i = 0; i < n - 1; i++) {
        for(j = 0; j < n - 1 - i; j++) {
            if(vet[j] > vet[j+1]) {
                temp = vet[j];
                vet[j] = vet[j+1];
                vet[j+1] = temp;
            }
        }
    }
}

int main(void) {
    int n, i;
    int *vet;

    printf("Digite o tamanho do vetor: ");
    scanf("%d", &n);

    vet = (int *)malloc(n * sizeof(int));
    if(vet == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    printf("Digite os %d elementos:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet[i]);
    }

    bubbleSort(vet, n);

    printf("Vetor ordenado:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", vet[i]);
    }
    printf("\n");

    free(vet);
    return 0;
}

```

