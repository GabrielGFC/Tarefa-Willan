### exercicios/bidimensional/exercicio10.c

*Soma de Duas Matrizes*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int m, n, i, j;
    int **matA, **matB, **matSoma;

    printf("Digite o numero de linhas (m): ");
    scanf("%d", &m);
    printf("Digite o numero de colunas (n): ");
    scanf("%d", &n);

    matA = (int **)malloc(m * sizeof(int *));
    matB = (int **)malloc(m * sizeof(int *));
    matSoma = (int **)malloc(m * sizeof(int *));
    if(matA == NULL || matB == NULL || matSoma == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < m; i++) {
        matA[i] = (int *)malloc(n * sizeof(int));
        matB[i] = (int *)malloc(n * sizeof(int));
        matSoma[i] = (int *)malloc(n * sizeof(int));
        if(matA[i] == NULL || matB[i] == NULL || matSoma[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    printf("Digite os elementos da matriz A:\n");
    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++){
            printf("A[%d][%d]: ", i, j);
            scanf("%d", &matA[i][j]);
        }

    printf("Digite os elementos da matriz B:\n");
    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++){
            printf("B[%d][%d]: ", i, j);
            scanf("%d", &matB[i][j]);
        }

    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++)
            matSoma[i][j] = matA[i][j] + matB[i][j];

    printf("Matriz soma (A + B):\n");
    for(i = 0; i < m; i++){
        for(j = 0; j < n; j++){
            printf("%d ", matSoma[i][j]);
        }
        printf("\n");
    }

    for(i = 0; i < m; i++){
        free(matA[i]);
        free(matB[i]);
        free(matSoma[i]);
    }
    free(matA);
    free(matB);
    free(matSoma);

    return 0;
}

