### exercicios/unidimensional/exercicio6.c

*Inverter a Ordem dos Elementos*

```c
#include <stdio.h>
#include <stdlib.h>

void inverter(int *vet, int n) {
    int i, temp;
    for(i = 0; i < n / 2; i++) {
        temp = vet[i];
        vet[i] = vet[n - 1 - i];
        vet[n - 1 - i] = temp;
    }
}

int main(void) {
    int n, i;
    int *vet;

    printf("Digite o tamanho do vetor: ");
    scanf("%d", &n);

    vet = (int *)malloc(n * sizeof(int));
    if(vet == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }

    printf("Digite os %d valores:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &vet[i]);
    }

    inverter(vet, n);

    printf("Vetor invertido:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", vet[i]);
    }
    printf("\n");

    free(vet);
    return 0;
}

```

