### exercicios/bidimensional/exercicio12.c

*Matriz Transposta*

```c
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int m, n, i, j;
    int **mat, **trans;

    printf("Digite o numero de linhas (m): ");
    scanf("%d", &m);
    printf("Digite o numero de colunas (n): ");
    scanf("%d", &n);

    mat = (int **)malloc(m * sizeof(int *));
    if(mat == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < m; i++) {
        mat[i] = (int *)malloc(n * sizeof(int));
        if(mat[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    trans = (int **)malloc(n * sizeof(int *));
    if(trans == NULL) {
        printf("Erro na alocacao.\n");
        return 1;
    }
    for(i = 0; i < n; i++) {
        trans[i] = (int *)malloc(m * sizeof(int));
        if(trans[i] == NULL) {
            printf("Erro na alocacao.\n");
            return 1;
        }
    }

    printf("Digite os elementos da matriz:\n");
    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++){
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }

    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++)
            trans[j][i] = mat[i][j];

    printf("Matriz original:\n");
    for(i = 0; i < m; i++){
        for(j = 0; j < n; j++){
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    printf("Matriz transposta:\n");
    for(i = 0; i < n; i++){
        for(j = 0; j < m; j++){
            printf("%d ", trans[i][j]);
        }
        printf("\n");
    }

    for(i = 0; i < m; i++)
        free(mat[i]);
    free(mat);
    for(i = 0; i < n; i++)
        free(trans[i]);
    free(trans);

    return 0;
}

